msgstr "Подключен к %s через RDP"

#: plugins/rdp/rdp_plugin.c:891 plugins/rdp/rdp_plugin.c:956
#: plugins/rdp/rdp_plugin.c:1049
msgid "Enter RDP authentication credentials"
msgstr "Введите данные авторизации RDP"

#: plugins/rdp/rdp_plugin.c:964 plugins/rdp/rdp_plugin.c:1060
