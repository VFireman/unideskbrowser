#, c-format
msgid "Disconnected from %s via RDP"
msgstr "Отключение от %s через RDP"

#: plugins/rdp/rdp_plugin.c:2680
msgid "Could not authenticate using smartcard."
msgstr "Не удалось аутентифицироваться через SmartCard."

#: plugins/rdp/rdp_plugin.c:2690
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Account locked out."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"Учётной записи закрыт доступ."

#: plugins/rdp/rdp_plugin.c:2697
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Account expired."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"Истёк срок учётной записи."

#: plugins/rdp/rdp_plugin.c:2704
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Password expired."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"Истёк пароль."

#: plugins/rdp/rdp_plugin.c:2711
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Account disabled."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"Учётная запись заблокирована."

#: plugins/rdp/rdp_plugin.c:2717
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Insufficient user privileges."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"У пользователя нет привилегий."

#: plugins/rdp/rdp_plugin.c:2725
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Account restricted."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"У учётной записи ограничения."

#: plugins/rdp/rdp_plugin.c:2733
#, c-format
msgid ""
"Could not access the RDP server “%s”.\n"
"Change user password before connecting."
msgstr ""
"Не удался доступ к RDP серверу \"%s\".\n"
"Пользователь должен сменить пароль перед соединением."

#: plugins/rdp/rdp_plugin.c:2738
#, c-format
msgid "Failed to connect to the RDP server “%s”."
msgstr "Не удалось подключиться к RDP серверу \"%s\"."

#: plugins/rdp/rdp_plugin.c:2741
#, c-format
msgid "Could not find the address for the RDP server “%s”."
msgstr "Не удалось найти адрес RDP сервера \"%s\"."

#: plugins/rdp/rdp_plugin.c:2745
#, c-format
msgid ""
"Could not connect to the RDP server “%s” via TLS. See the DEBUG traces from "
"a terminal for more information."
msgstr ""
"Ошибка соединения с RDP сервером “%s” через TLS. Для получения "
"дополнительной информации смотрите трассировку DEBUG из терминала."

#: plugins/rdp/rdp_plugin.c:2749
#, c-format
msgid ""
"Unable to establish a connection to the RDP server “%s”. Check “Security "
"protocol negotiation”."
msgstr ""
"Невозможно установить соединение с RDP-сервером \"%s\". Проверьте "
"“Согласование протокола безопасности”."

#: plugins/rdp/rdp_plugin.c:2757
#, c-format
msgid "Cannot connect to the RDP server “%s”."
msgstr "Невозможно подключиться к RDP серверу \"%s\"."

#: plugins/rdp/rdp_plugin.c:2760
msgid "Could not start libfreerdp-gdi."
msgstr "Невозможно запустить libfreerdp-gdi."

#: plugins/rdp/rdp_plugin.c:2763
#, c-format
msgid ""
"You requested a H.264 GFX mode for the server “%s”, but your libfreerdp does "
"not support H.264. Please use a non-AVC colour depth setting."
msgstr ""
"Вы запросили режим H.264 GFX для сервера \"%s\", но ваш libfreerdp не "
"поддерживает H.264. Пожалуйста, используйте настройки цветовой глубины не-"
"AVC формата."

#: plugins/rdp/rdp_plugin.c:2770
#, c-format
msgid "The “%s” server refused the connection."
msgstr "Сервер \"%s\" отклонил соединение."

#: plugins/rdp/rdp_plugin.c:2775
#, c-format
msgid ""
"The Remote Desktop Gateway “%s” denied the user “%s\\%s” access due to "
"policy."
msgstr ""
"Шлюз удалённого доступа “%s” запретил пользователю “%s\\%s” доступ, из-за "
"его политик."

#: plugins/rdp/rdp_plugin.c:2785
#, c-format
msgid "Cannot connect to the “%s” RDP server."
msgstr "Невозможно подключиться к \"%s\" RDP серверу."

